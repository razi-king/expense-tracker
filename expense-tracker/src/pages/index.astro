---
import Layout from '../layouts/Layout.astro'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<Layout title="Expense Tracker">
	<script is:inline define:vars={{ base }}>
		// Logged in → dashboard, otherwise → login
		location.replace(base + (localStorage.getItem('et.token') ? '/dashboard' : '/login'))
	</script>
	<noscript><a href={`${base}/login`}>Log in</a></noscript>
</Layout>
